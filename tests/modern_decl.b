int g = 7;
char gc = 'Q';
float gf = 2.5;
char gs[] = "global";
int gz;
main() {
    int age = 16;
    char letter = 'B';
    char greeting[] = "Hello";
    float pi = 3.14159;
    int zero;
    int a = 1, b = 2, c;
    printf("%d %c %s %.2f %d\n", age, letter, greeting, pi, zero);
    printf("%d %c %.1f %s %d\n", g, gc, gf, gs, gz);
    printf("%d %d %d\n", a, b, c);
    int n = 'A';
    char d = 66;
    printf("%d %c\n", n, d);
}
